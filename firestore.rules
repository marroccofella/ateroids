rules_version = '2';

// Locked down by default. The game is fully client-side and does not
// currently read or write Firestore, so nothing is exposed.
// If a leaderboard is added later, open ONLY the specific collection,
// e.g. allow read on /scores and validated create-only writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
